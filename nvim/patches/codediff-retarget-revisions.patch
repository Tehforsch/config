@@ -369,6 +369,22 @@ function M.refresh(explorer)
   end
 end
 
+function M.retarget_revisions(explorer, base_revision, target_revision)
+  if not explorer or not explorer.git_root then
+    return false
+  end
+
+  explorer.base_revision = base_revision
+  explorer.target_revision = target_revision
+  explorer.status_result = nil
+  explorer.force_next_selection = true
+
+  local lifecycle = require("codediff.ui.lifecycle")
+  lifecycle.update_revisions(explorer.tabpage, base_revision, target_revision)
+  M.refresh(explorer)
+  return true
+end
+
